# Kopiér til .env og ret værdierne:  cp .env.example .env

# Port på Raspberry Pi'en (kontrolpanel: http://<hostname>:PORT/admin)
PORT=8000

# Navn vist i kontrolpanelet
APP_NAME=Talerstol

# Login til kontrolpanelet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=skift-mig

# Display (/display) og monitor (/monitor) uden login (true/false)
PUBLIC_DISPLAY=true
PUBLIC_MONITOR=true

# Maksimal størrelse på uploadede billeder (MB)
MAX_UPLOAD_MB=20

# Hemmelig nøgle til login-cookies. Tom = genereres og gemmes i datavolumen.
# Generér evt. med:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Hvor længe et login gælder (sekunder). Standard: 12 timer
SESSION_MAX_AGE=43200

# Opret standardscener (fallback-logo, Formand, Dirigent) i en tom database
SEED_DEFAULTS=true

# Datamappe ved kørsel uden Docker (i Docker styres den af docker-compose.yml)
DATA_DIR=data
